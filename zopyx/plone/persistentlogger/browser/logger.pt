<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="zopyx.plone.persistentlogger">
<body>

    <metal:slot fill-slot="javascript_head_slot">
        <script>
            window.__define = window.define;
            window.__require = window.require;
            window.define = undefined;
            window.require = undefined;
        </script>
        <script type="text/javascript" charset="utf8" tal:attributes="src string:$portal_url/++resource++zopyx.plone.persistentlogger/aggrid/ag-grid-community.min.js"></script>
        <script>
            window.define = window.__define;
            window.require = window.__require;
            window.__define = undefined;
            window.__require = undefined;
        </script>
        <script type="text/javascript" charset="utf8" tal:attributes="src string:$portal_url/++resource++zopyx.plone.persistentlogger/persistent-log.js"></script>
    </metal:slot>

    <metal:slot fill-slot="style_slot">
        <link rel="stylesheet" type="text/css" tal:attributes="href string:$portal_url/++resource++zopyx.plone.persistentlogger/aggrid/ag-grid.min.css" />
        <link rel="stylesheet" type="text/css" tal:attributes="href string:$portal_url/++resource++zopyx.plone.persistentlogger/aggrid/ag-theme-quartz-no-font.min.css" />
        <link rel="stylesheet" type="text/css" tal:attributes="href string:$portal_url/++resource++zopyx.plone.persistentlogger/styles.css" />
    </metal:slot>


<metal:main fill-slot="content-core">
    <metal:content-core define-macro="content-core"
        tal:define="toLocalizedTime nocall:context/@@plone/toLocalizedTime">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0" i18n:translate="">Logging</h2>
        <div class="btn-group">
          <tal:manager condition="view/is_manager">
            <a class="btn btn-outline-secondary btn-sm"
               tal:attributes="href string:${context/absolute_url}/@@persistent-log-retention"
               i18n:translate="">Retention</a>
            <div class="btn-group" role="group">
              <button type="button" class="btn btn-outline-primary btn-sm dropdown-toggle"
                      data-bs-toggle="dropdown" aria-expanded="false" i18n:translate="">Export</button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" tal:attributes="href string:${context/absolute_url}/@@persistent-log-export?format=json">JSON</a></li>
                <li><a class="dropdown-item" tal:attributes="href string:${context/absolute_url}/@@persistent-log-export?format=csv">CSV</a></li>
                <li><a class="dropdown-item" tal:attributes="href string:${context/absolute_url}/@@persistent-log-export?format=xlsx">XLSX</a></li>
                <li><a class="dropdown-item" tal:attributes="href string:${context/absolute_url}/@@persistent-log-export?format=ods">ODS</a></li>
              </ul>
            </div>
          </tal:manager>
          <a class="btn btn-outline-secondary btn-sm"
             tal:attributes="href string:${context/absolute_url}/@@logger-entries"
             i18n:translate="">JSON</a>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <div class="card">
            <div class="card-body py-2 d-flex justify-content-between align-items-center">
              <span class="text-muted small" i18n:translate="">Entries</span>
              <span class="badge text-bg-primary rounded-pill"><tal:count tal:content="view/count" /></span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card">
            <div class="card-body py-2 d-flex justify-content-between align-items-center">
              <span class="text-muted small" i18n:translate="">Last entry</span>
              <span class="small"
                    tal:content="python: context.toLocalizedTime(view.last_date(), True) if view.last_date() else '—'" />
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card">
            <div class="card-body py-2 d-flex justify-content-between align-items-center">
              <span class="text-muted small" i18n:translate="">Last user</span>
              <span class="badge text-bg-light border rounded-pill"
                    tal:content="python: view.last_user() or '—'" />
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <input type="search" id="persistent-log-quick" class="form-control form-control-sm"
               style="max-width: 22rem" placeholder="Quick filter…"
               i18n:attributes="placeholder" />
        <button type="button" id="persistent-log-reset" class="btn btn-outline-secondary btn-sm"
                i18n:translate="">Reset filters</button>
        <span id="persistent-log-status" class="small text-body-secondary ms-auto"></span>
      </div>

      <!-- Server side rendering: paging, sorting and filtering happen in
           @@persistent-log-data, the browser only receives one page. -->
      <div id="persistent-log-grid" class="ag-theme-quartz"
           style="height: 70vh; width: 100%"></div>

      <script type="text/javascript"
              tal:content="structure python:'window.PERSISTENT_LOGGER_CONFIG = %s;' % view.grid_config()"></script>

  </metal:content-core>
</metal:main>

</body>
</html>
