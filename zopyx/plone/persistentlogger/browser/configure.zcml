<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    xmlns:browser="http://namespaces.zope.org/browser"
    >
    
    <include package="Products.CMFCore" />

    <permission
        id="zopyx.plone.persistentlogger.ViewAuditLog"
        title="View audit log"
    />

    <permission
        id="zopyx.plone.persistentlogger.ExportAuditLog"
        title="Export audit log"
    />
    <permission
        id="zopyx.plone.persistentlogger.ManageAuditRetention"
        title="Manage audit retention"
    />
    <permission
        id="zopyx.plone.persistentlogger.ManageAuditHold"
        title="Manage audit legal holds"
    />
    <permission
        id="zopyx.plone.persistentlogger.CreateAuditDemo"
        title="Create audit demo data"
    />

    <browser:page
        for="*"
        name="logger-demo"
        class=".logger.Logging"
        attribute="demo"
        layer="zopyx.plone.persistentlogger.interfaces.DemoBrowserLayer"
        permission="cmf.ModifyPortalContent"
    />

    <browser:page
        for="*"
        name="persistent-log"
        class=".logger.Logging"
        template="logger.pt"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="zopyx.plone.persistentlogger.ViewAuditLog"
    />

    <browser:page
        for="*"
        name="logger-entries"
        class=".logger.Logging"
        attribute="entries_json"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="zopyx.plone.persistentlogger.ViewAuditLog"
    />

    <browser:page
        for="*"
        name="persistent-log-data"
        class=".logger.Logging"
        attribute="entries_data"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="zopyx.plone.persistentlogger.ViewAuditLog"
    />

    <browser:page
        for="*"
        name="persistent-log-export"
        class=".retention.Export"
        permission="zopyx.plone.persistentlogger.ExportAuditLog"
    />

    <browser:page
        for="*"
        name="persistent-log-retention-preview"
        class=".retention.Retention"
        attribute="preview"
        permission="zopyx.plone.persistentlogger.ManageAuditRetention"
    />

    <browser:page
        for="*"
        name="persistent-log-retention-delete"
        class=".retention.Retention"
        attribute="delete"
        permission="zopyx.plone.persistentlogger.ManageAuditRetention"
    />

    <browser:page
        for="*"
        name="persistent-log-retention"
        class=".retention.RetentionGUI"
        permission="zopyx.plone.persistentlogger.ManageAuditRetention"
    />

    <browser:page
        for="zope.interface.Interface"
        name="audit-logging-settings"
        class=".settings.AuditLoggingSettingsView"
        permission="cmf.ManagePortal"
    />

    <browser:page
        for="zope.interface.Interface"
        name="audit-storage-settings"
        class=".storage.StorageSettingsView"
        permission="cmf.ManagePortal"
    />

    <browser:page
        for="*"
        name="persistent-log-api"
        class=".api.AuditAPI"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="zopyx.plone.persistentlogger.ViewAuditLog"
    />
    <browser:page
        for="*"
        name="persistent-log-api-export"
        class=".api.AuditExportAPI"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="zopyx.plone.persistentlogger.ExportAuditLog"
    />
    <browser:page
        for="*"
        name="persistent-log-api-hold"
        class=".api.HoldAPI"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="zopyx.plone.persistentlogger.ManageAuditHold"
    />

    <browser:page
        for="*"
        name="persistent-log-integrity"
        class=".integrity.IntegrityHealthView"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="cmf.ManagePortal"
    />

    <browser:resourceDirectory
        name="zopyx.plone.persistentlogger"
        directory="resources"
    />

</configure>
