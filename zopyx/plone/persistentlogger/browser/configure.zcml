<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    xmlns:browser="http://namespaces.zope.org/browser"
    >
    
    <include package="Products.CMFCore" />

    <browser:page
        for="*"
        name="logger-demo"
        class=".logger.Logging"
        attribute="demo"
        layer="zopyx.plone.persistentlogger.interfaces.DemoBrowserLayer"
        permission="cmf.ModifyPortalContent"
    />

    <browser:page
        for="*"
        name="persistent-log"
        class=".logger.Logging"
        template="logger.pt"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="cmf.ModifyPortalContent"
    />

    <browser:page
        for="*"
        name="logger-entries"
        class=".logger.Logging"
        attribute="entries_json"
        layer="zopyx.plone.persistentlogger.interfaces.BrowserLayer"
        permission="cmf.ModifyPortalContent"
    />

    <browser:page
        for="*"
        name="persistent-log-export"
        class=".retention.Export"
        permission="cmf.ManagePortal"
    />

    <browser:page
        for="*"
        name="persistent-log-retention-preview"
        class=".retention.Retention"
        attribute="preview"
        permission="cmf.ManagePortal"
    />

    <browser:page
        for="*"
        name="persistent-log-retention-delete"
        class=".retention.Retention"
        attribute="delete"
        permission="cmf.ManagePortal"
    />

    <browser:resourceDirectory
        name="zopyx.plone.persistentlogger"
        directory="resources"
    />

</configure>
